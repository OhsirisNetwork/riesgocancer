), (36518808), (44500587), (36550929), (36554307), (44503204), (36564290), (36568204), (36568135), (36527742), (36547553), (36538987), (36538582), (36537230), (36559186), (36531433), (36562727)) AS t(concept_id)
),

/* 2) Index Date */
index_visits AS (
SELECT v.person_id, MIN(v.visit_start_date) AS index_date
FROM visit_occurrence v
JOIN params p ON v.visit_start_date BETWEEN p.start_index_date AND p.end_index_date
GROUP BY v.person_id
--limit 1000

),

/* 3) Inclusion Criteria */
eligible_patients AS (
SELECT
iv.person_id, iv.index_date, p.gender_concept_id, p.year_of_birth, d.min_death_date AS death_date
FROM index_visits iv
CROSS JOIN params par
JOIN person p ON iv.person_id = p.person_id
JOIN observation_period op ON iv.person_id = op.person_id
AND iv.index_date BETWEEN op.observation_period_start_date AND op.observation_period_end_date
LEFT JOIN (
SELECT person_id, MIN(death_date) AS min_death_date
FROM death
GROUP BY person_id
) d ON iv.person_id = d.person_id
WHERE (EXTRACT(YEAR FROM iv.index_date) - p.year_of_birth) >= 18
AND p.gender_concept_id IN (8507, 8532)
AND op.observation_period_start_date <= (iv.index_date - (par.prior_observation_years || ' years')::interval)
AND (d.min_death_date IS NULL OR ( d.min_death_date >= iv.index_date AND EXTRACT(YEAR FROM d.min_death_date) >= p.year_of_birth ))
AND NOT EXISTS (
SELECT 1 FROM condition_occurrence co
WHERE co.person_id = iv.person_id
AND co.condition_concept_id IN (SELECT concept_id FROM cancer_concepts_full)
AND co.condition_start_date < iv.index_date
)

),

/* 4) Outcome Event - prediction period */
outcomes AS (
SELECT ep.person_id, MIN(co.condition_start_date) AS first_cancer_date
FROM eligible_patients ep
JOIN condition_occurrence co ON ep.person_id = co.person_id
JOIN params par ON co.condition_start_date BETWEEN ep.index_date AND par.admin_censor_date
WHERE co.condition_concept_id IN (SELECT concept_id FROM cancer_concepts_full)
GROUP BY ep.person_id
),

/* 5) Final Cohort Assembly */
cohort_final AS (
SELECT ep.person_id AS subject_id, ep.index_date, ep.gender_concept_id, ep.year_of_birth, ep.death_date, o.first_cancer_date,
CASE WHEN o.first_cancer_date IS NOT NULL THEN 1 ELSE 0 END AS event_occurred,
LEAST(COALESCE(o.first_cancer_date, DATE '9999-12-31'), COALESCE(ep.death_date, DATE '9999-12-31'), par.admin_censor_date) AS end_followup_date
FROM eligible_patients ep
LEFT JOIN outcomes o ON ep.person_id = o.person_id
CROSS JOIN params par
),

/* 6) Sampling - Proportion 5:1 */
all_cases AS (SELECT * FROM cohort_final WHERE event_occurred = 1),
all_controls AS (SELECT * FROM cohort_final WHERE event_occurred = 0),

sampled_cases AS (
SELECT * FROM all_cases
ORDER BY MD5(subject_id::TEXT || 'semilla_2024')
LIMIT (SELECT (sample_size * 1/6)::INT FROM params)
),

sampled_controls AS (
SELECT c.* FROM all_controls c
INNER JOIN (SELECT COUNT(*) as n FROM sampled_cases) sc ON TRUE
ORDER BY MD5(c.subject_id::TEXT || 'semilla_2024')
LIMIT (SELECT COUNT(*) * 5 FROM sampled_cases)
),

sampled_final AS (
SELECT * FROM sampled_cases
UNION ALL
SELECT * FROM sampled_controls
),

/* 7) Predictor concept list */
predictor_concepts AS (
SELECT 'COPD' AS var, descendant_concept_id AS cid FROM concept_ancestor WHERE ancestor_concept_id = 255573
UNION ALL
SELECT 'Asthma', descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id = 317009
UNION ALL
SELECT 'Diabetes', descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id = 201820
UNION ALL
SELECT 'Cardiovascular_Disease', descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id IN (4134586, 4185932)
UNION ALL
SELECT 'Hypertension', descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id = 316866
UNION ALL
SELECT 'Smoking', descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id = 4209423
UNION ALL
SELECT 'Pulmonary_Fibrosis', concept_id FROM concept WHERE concept_id IN (253797, 45763750, 4025168)
UNION ALL
SELECT 'Pneumonia', descendant_concept_id FROM concept_ancestor WHERE ancestor_concept_id = 255848
),

/* 8) Covariables - observation period */
cond_cov AS (
SELECT sf.subject_id,
MAX(CASE WHEN pc.var = 'COPD' THEN 1 ELSE 0 END) AS has_copd,
MAX(CASE WHEN pc.var = 'Asthma' THEN 1 ELSE 0 END) AS has_asthma,
MAX(CASE WHEN pc.var = 'Diabetes' THEN 1 ELSE 0 END) AS has_diabetes,
MAX(CASE WHEN pc.var = 'Cardiovascular_Disease' THEN 1 ELSE 0 END) AS has_cvd,
MAX(CASE WHEN pc.var = 'Hypertension' THEN 1 ELSE 0 END) AS has_htn,
MAX(CASE WHEN pc.var = 'Smoking' THEN 1 ELSE 0 END) AS has_smoking,
MAX(CASE WHEN pc.var = 'Pneumonia' THEN 1 ELSE 0 END) AS has_pneumonia,
MAX(CASE WHEN pc.var = 'Pulmonary_Fibrosis' THEN 1 ELSE 0 END) AS has_fibrosis
FROM sampled_final sf
JOIN params par ON TRUE
JOIN condition_occurrence co ON sf.subject_id = co.person_id
AND co.condition_start_date BETWEEN (sf.index_date - (par.prior_observation_years || ' years')::interval) AND sf.index_date
JOIN predictor_concepts pc ON co.condition_concept_id = pc.cid
GROUP BY sf.subject_id
),

visit_cov AS (
SELECT sf.subject_id,
COUNT(DISTINCT CASE WHEN (v.visit_concept_id = 9203 AND v.visit_source_value = 'Emergency Room Visit') THEN v.visit_occurrence_id END) AS prior_er_visits,
COUNT(DISTINCT CASE WHEN (v.visit_concept_id = 9201 AND v.visit_source_value = 'Inpatient Visit') THEN v.visit_occurrence_id END) AS prior_inpatient_visits
FROM sampled_final sf
JOIN params par ON TRUE
JOIN visit_occurrence v ON sf.subject_id = v.person_id
AND v.visit_start_date BETWEEN (sf.index_date - (par.prior_observation_years || ' years')::interval) AND sf.index_date
WHERE v.visit_concept_id IN (9203, 9201)
GROUP BY sf.subject_id
)

/* Final Result */
SELECT
s.subject_id,
s.index_date,
s.end_followup_date,
s.death_date,
s.event_occurred AS status,
(s.end_followup_date - s.index_date) AS days_to_event,
s.gender_concept_id,
CAST(EXTRACT(YEAR FROM s.index_date) - s.year_of_birth AS INTEGER) AS age,
COALESCE(ccv.has_copd, 0) AS copd,
COALESCE(ccv.has_asthma, 0) AS asthma,
COALESCE(ccv.has_diabetes, 0) AS diabetes,
COALESCE(ccv.has_cvd, 0) AS cvd,
COALESCE(ccv.has_htn, 0) AS hypertension,
COALESCE(ccv.has_smoking, 0) AS smoking,
COALESCE(ccv.has_fibrosis, 0) AS fibrosis,
COALESCE(ccv.has_pneumonia, 0) AS pneumonia,
COALESCE(vcv.prior_er_visits, 0) AS prior_er_visits,
COALESCE(vcv.prior_inpatient_visits, 0) AS prior_inpatient_visits
FROM sampled_final s
LEFT JOIN cond_cov ccv ON s.subject_id = ccv.subject_id
LEFT JOIN visit_cov vcv ON s.subject_id = vcv.subject_id;
ENTRADABD	vBD		INSERT INTO supervivencia_2 (
