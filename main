"port":"5432",
"user":"************",
"password":"***********",
"query_sql":"SELECT r_object_id, CAST(days_to_event AS numeric) / 365.25 AS time_years, CAST(subject_id AS integer) AS subject_id, CAST(index_date AS date) AS index_date, CAST(end_followup_date AS date) AS end_followup_date, CAST(CASE WHEN death_date != '' THEN death_date END AS date) AS death_date, CAST(status AS integer) AS status, CAST(days_to_event AS integer) AS days_to_event, CAST(gender_concept_id AS integer) AS gender_concept_id, CAST(age AS integer) AS age, CAST(copd AS integer) AS copd, CAST(asthma AS integer) AS asthma, CAST(diabetes AS integer) AS diabetes, CAST(cvd AS integer) AS cvd, CAST(hypertension AS integer) AS hypertension, CAST(smoking AS integer) AS smoking, CAST(fibrosis AS integer) AS fibrosis, CAST(pneumonia AS integer) AS pneumonia, CAST(prior_er_visits AS integer) AS prior_er_visits, CAST(prior_inpatient_visits AS integer) AS prior_inpatient_visits FROM public.supervivencia_2",
"r_object_id": "P1_LC_Risk"
}
}
RESULTADO	table	vBD	SELECT * FROM public.resultados_rstudio
where r_object_id = 'P1_LC_Risk'
order by id desc
limit 1
